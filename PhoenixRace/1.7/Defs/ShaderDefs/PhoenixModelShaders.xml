<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ShaderDef>
    <defName>Phoenix_ModelGeometry</defName>
    <shaderProgram>
      <vertexShaderFileName>PhoenixModel/Geometry.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PhoenixModel/Geometry.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
