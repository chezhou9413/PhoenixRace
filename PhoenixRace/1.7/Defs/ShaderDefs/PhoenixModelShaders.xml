  </ShaderDef>
  <ShaderDef>
    <defName>Phoenix_ModelComposite</defName>
    <shaderProgram>
      <vertexShaderFileName>PhoenixModel/Composite.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PhoenixModel/Composite.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>false</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <blendMode>Opaque</blendMode>
    </shaderProgram>
  </ShaderDef>
  <ShaderDef>
    <defName>Phoenix_ModelDisplay</defName>
    <shaderProgram>
      <vertexShaderFileName>PhoenixModel/Display.vert.glsl</vertexShaderFileName>
